DATABASE_URL=postgresql://usuario:senha@localhost:5432/sam
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false
PORT=3001
AUDIT_IDENTIFIER_SECRET=gere-outra-chave-aleatoria-com-pelo-menos-32-caracteres
# Sessão: o cookie HttpOnly é renovado (token novo) após este intervalo, em segundos (padrão 600 = 10 min)
SESSION_ROTATE_SECONDS=600
# Vida máxima da sessão desde o login, em segundos (padrão 28800 = 8 h)
SESSION_ABSOLUTE_MAX_SECONDS=28800
# LGPD: identificação pública do controlador e do encarregado (Res. CD/ANPD 18/2024, art. 9º)
CONTROLADOR_NOME=Prefeitura Municipal de ______ — Secretaria de Saúde
ENCARREGADO_NOME=Nome do(a) encarregado(a)
ENCARREGADO_EMAIL=encarregado@municipio.gov.br
